# ==============================================================================
# THE SPROUTS SPOT — SUPABASE & ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Supabase credentials (accessible in the browser and server)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret Supabase Service Role Key (SERVER ONLY — NEVER EXPOSE TO BROWSER)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role secret
# Used exclusively inside secure server-side route handlers / actions for identity mapping
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Demo role switcher flag (Strictly disabled in production / Vercel)
# Defaults to false. If set to true, only enabled when NODE_ENV !== "production"
ENABLE_DEV_DEMO_BAR=false

